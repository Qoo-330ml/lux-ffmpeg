From: lux <dev@lux.invalid>
Subject: [PATCH] videotoolbox: take colour tags from the CVPixelBuffer

VideoToolbox 会把颜色描述作为 CoreVideo attachment 挂在解码输出的
CVPixelBuffer 上(kCVImageBufferYCbCrMatrixKey / ColorPrimariesKey /
TransferFunctionKey / ChromaLocationTopFieldKey);ffmpeg 8.1.3 只在
编码/上传方向写这些 attachment(vt_pixbuf_set_colorspace),解码方向
从不读取。

HEVC 码流没有 VUI 色彩描述(典型:Dolby Vision Profile 5)时,
AVFrame.colorspace 保持 0(AVCOL_SPC_RGB),mpv/libplacebo 便按
RGB/full/sRGB 处理,零拷贝画面偏紫或偏绿。本补丁在 hwaccel 的
post_process 里读取 attachment,只填补 AVFrame 中仍为
unspecified 的字段;码流/容器已有的描述优先。平面 YUV 帧上的
AVCOL_SPC_RGB 视为 "未设置"(它是枚举零值,不是真实标签)。

本补丁为 lux 原创,LGPL-2.1+。

---
--- a/libavcodec/videotoolbox.c
+++ b/libavcodec/videotoolbox.c
@@ -116,6 +116,173 @@
     return 0;
 }
 
+static enum AVColorSpace vt_map_ycbcr_matrix(CFStringRef value)
+{
+    if (!value)
+        return AVCOL_SPC_UNSPECIFIED;
+    if (CFEqual(value, kCVImageBufferYCbCrMatrix_ITU_R_709_2))
+        return AVCOL_SPC_BT709;
+    if (CFEqual(value, kCVImageBufferYCbCrMatrix_ITU_R_601_4))
+        return AVCOL_SPC_SMPTE170M;
+    if (CFEqual(value, kCVImageBufferYCbCrMatrix_SMPTE_240M_1995))
+        return AVCOL_SPC_SMPTE240M;
+#if HAVE_KCVIMAGEBUFFERYCBCRMATRIX_ITU_R_2020
+    if (__builtin_available(macOS 10.11, iOS 9, *)) {
+        if (CFEqual(value, kCVImageBufferYCbCrMatrix_ITU_R_2020))
+            return AVCOL_SPC_BT2020_NCL;
+    }
+#endif
+    return AVCOL_SPC_UNSPECIFIED;
+}
+
+static enum AVColorPrimaries vt_map_color_primaries(CFStringRef value)
+{
+    if (!value)
+        return AVCOL_PRI_UNSPECIFIED;
+    if (CFEqual(value, kCVImageBufferColorPrimaries_ITU_R_709_2))
+        return AVCOL_PRI_BT709;
+    if (CFEqual(value, kCVImageBufferColorPrimaries_EBU_3213))
+        return AVCOL_PRI_BT470BG;
+    if (CFEqual(value, kCVImageBufferColorPrimaries_SMPTE_C))
+        return AVCOL_PRI_SMPTE170M;
+#if HAVE_KCVIMAGEBUFFERCOLORPRIMARIES_ITU_R_2020
+    if (__builtin_available(macOS 10.11, iOS 9, *)) {
+        if (CFEqual(value, kCVImageBufferColorPrimaries_ITU_R_2020))
+            return AVCOL_PRI_BT2020;
+    }
+#endif
+    return AVCOL_PRI_UNSPECIFIED;
+}
+
+static enum AVColorTransferCharacteristic vt_map_color_trc(CFStringRef value)
+{
+    if (!value)
+        return AVCOL_TRC_UNSPECIFIED;
+    if (CFEqual(value, kCVImageBufferTransferFunction_ITU_R_709_2))
+        return AVCOL_TRC_BT709;
+#if HAVE_KCVIMAGEBUFFERTRANSFERFUNCTION_ITU_R_2020
+    if (__builtin_available(macOS 10.11, iOS 9, *)) {
+        if (CFEqual(value, kCVImageBufferTransferFunction_ITU_R_2020))
+            return AVCOL_TRC_BT2020_10;
+    }
+#endif
+#if HAVE_KCVIMAGEBUFFERTRANSFERFUNCTION_SMPTE_ST_2084_PQ
+    if (__builtin_available(macOS 10.13, iOS 11, *)) {
+        if (CFEqual(value, kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ))
+            return AVCOL_TRC_SMPTE2084;
+    }
+#endif
+#if HAVE_KCVIMAGEBUFFERTRANSFERFUNCTION_ITU_R_2100_HLG
+    if (__builtin_available(macOS 10.13, iOS 11, *)) {
+        if (CFEqual(value, kCVImageBufferTransferFunction_ITU_R_2100_HLG))
+            return AVCOL_TRC_ARIB_STD_B67;
+    }
+#endif
+    return AVCOL_TRC_UNSPECIFIED;
+}
+
+static enum AVChromaLocation vt_map_chroma_location(CFStringRef value)
+{
+    if (!value)
+        return AVCHROMA_LOC_UNSPECIFIED;
+    if (CFEqual(value, kCVImageBufferChromaLocation_Left))
+        return AVCHROMA_LOC_LEFT;
+    if (CFEqual(value, kCVImageBufferChromaLocation_Center))
+        return AVCHROMA_LOC_CENTER;
+    if (CFEqual(value, kCVImageBufferChromaLocation_Top))
+        return AVCHROMA_LOC_TOP;
+    if (CFEqual(value, kCVImageBufferChromaLocation_Bottom))
+        return AVCHROMA_LOC_BOTTOM;
+    if (CFEqual(value, kCVImageBufferChromaLocation_TopLeft))
+        return AVCHROMA_LOC_TOPLEFT;
+    if (CFEqual(value, kCVImageBufferChromaLocation_BottomLeft))
+        return AVCHROMA_LOC_BOTTOMLEFT;
+    return AVCHROMA_LOC_UNSPECIFIED;
+}
+
+static enum AVColorRange vt_pixbuf_color_range(CVPixelBufferRef pixbuf)
+{
+    switch (CVPixelBufferGetPixelFormatType(pixbuf)) {
+    case kCVPixelFormatType_32BGRA:
+    case kCVPixelFormatType_32ARGB:
+    case kCVPixelFormatType_32ABGR:
+    case kCVPixelFormatType_32RGBA:
+    case kCVPixelFormatType_422YpCbCr8FullRange:
+    case kCVPixelFormatType_420YpCbCr8BiPlanarFullRange:
+    case kCVPixelFormatType_420YpCbCr8PlanarFullRange:
+        return AVCOL_RANGE_JPEG;
+#if HAVE_KCVPIXELFORMATTYPE_420YPCBCR10BIPLANARVIDEORANGE
+    case kCVPixelFormatType_420YpCbCr10BiPlanarFullRange:
+        return AVCOL_RANGE_JPEG;
+    case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+        return AVCOL_RANGE_MPEG;
+#endif
+#if HAVE_KCVPIXELFORMATTYPE_422YPCBCR10BIPLANARVIDEORANGE
+    case kCVPixelFormatType_422YpCbCr10BiPlanarFullRange:
+        return AVCOL_RANGE_JPEG;
+    case kCVPixelFormatType_422YpCbCr10BiPlanarVideoRange:
+        return AVCOL_RANGE_MPEG;
+#endif
+#if HAVE_KCVPIXELFORMATTYPE_444YPCBCR10BIPLANARVIDEORANGE
+    case kCVPixelFormatType_444YpCbCr10BiPlanarFullRange:
+        return AVCOL_RANGE_JPEG;
+    case kCVPixelFormatType_444YpCbCr10BiPlanarVideoRange:
+        return AVCOL_RANGE_MPEG;
+#endif
+    default:
+        return AVCOL_RANGE_UNSPECIFIED;
+    }
+}
+
+/*
+ * VideoToolbox can attach the colour description to the CVPixelBuffer even
+ * when the HEVC VUI (or the container) carries none. FFmpeg used to drop those
+ * attachments on the floor, which left hardware frames with a zeroed
+ * AVFrame.colorspace (AVCOL_SPC_RGB, i.e. full-range sRGB) and made a
+ * zero-copy renderer pick BT.709/sRGB/full for an HDR signal.
+ *
+ * Keep any description the decoder/container already provided; only fill the
+ * gaps from the buffer. A planar YUV buffer with AVCOL_SPC_RGB is treated as
+ * unspecified because "RGB" is the zero value of the enum, not a real tag.
+ */
+static void vt_pixbuf_get_colorspace(CVPixelBufferRef pixbuf, AVFrame *frame)
+{
+    const int planar_yuv = CVPixelBufferIsPlanar(pixbuf);
+    CFTypeRef value;
+
+    if (frame->colorspace == AVCOL_SPC_UNSPECIFIED ||
+        (frame->colorspace == AVCOL_SPC_RGB && planar_yuv)) {
+        value = CVBufferCopyAttachment(pixbuf, kCVImageBufferYCbCrMatrixKey, NULL);
+        frame->colorspace = vt_map_ycbcr_matrix(value);
+        if (value)
+            CFRelease(value);
+    }
+
+    if (frame->color_primaries == AVCOL_PRI_UNSPECIFIED) {
+        value = CVBufferCopyAttachment(pixbuf, kCVImageBufferColorPrimariesKey, NULL);
+        frame->color_primaries = vt_map_color_primaries(value);
+        if (value)
+            CFRelease(value);
+    }
+
+    if (frame->color_trc == AVCOL_TRC_UNSPECIFIED) {
+        value = CVBufferCopyAttachment(pixbuf, kCVImageBufferTransferFunctionKey, NULL);
+        frame->color_trc = vt_map_color_trc(value);
+        if (value)
+            CFRelease(value);
+    }
+
+    if (frame->color_range == AVCOL_RANGE_UNSPECIFIED)
+        frame->color_range = vt_pixbuf_color_range(pixbuf);
+
+    if (frame->chroma_location == AVCHROMA_LOC_UNSPECIFIED) {
+        value = CVBufferCopyAttachment(pixbuf, kCVImageBufferChromaLocationTopFieldKey, NULL);
+        frame->chroma_location = vt_map_chroma_location(value);
+        if (value)
+            CFRelease(value);
+    }
+}
+
 static int videotoolbox_postproc_frame(void *avctx, AVFrame *frame)
 {
     int ret;
@@ -135,6 +302,8 @@
     if ((ret = av_vt_pixbuf_set_attachments(avctx, ref->pixbuf, frame)) < 0)
         return ret;
 
+    vt_pixbuf_get_colorspace(ref->pixbuf, frame);
+
     frame->data[3] = (uint8_t*)ref->pixbuf;
 
     if (ref->hw_frames_ctx) {
